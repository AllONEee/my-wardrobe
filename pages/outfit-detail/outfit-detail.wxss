.hero {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 520rpx;
  padding: 24rpx;
  border-radius: var(--radius);
  background: var(--card);
  box-shadow: var(--shadow);
}

.hero__img {
  width: 100%;
  height: 480rpx;
}

.hero__empty {
  padding: 60rpx 40rpx;
  text-align: center;
}

.hero__empty-title {
  font-size: 30rpx;
  font-weight: 500;
}

.hero__empty-desc {
  max-width: 460rpx;
  margin-top: 12rpx;
  color: var(--text-sub);
  font-size: 25rpx;
  line-height: 1.7;
}

.info {
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
}

.section {
  margin-top: 20rpx;
  padding: 24rpx;
}

.section__title {
  margin-bottom: 12rpx;
  color: var(--text-sub);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.note {
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

/* ==================== 关联衣物 ==================== */

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.grid__cell {
  box-sizing: border-box;
  width: 33.3333%;
  padding: 0 8rpx 20rpx;
}

.empty-items {
  padding: 40rpx 8rpx;
  color: var(--text-light);
  font-size: 26rpx;
}

.created {
  padding: 24rpx 8rpx 8rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

.toolbar__gap {
  margin: 0 16rpx;
}
