page {
  overflow: hidden;
}

.editor {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 100vh;
  background: var(--bg);
}

/* ==================== 顶部操作 ==================== */

.topbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--card);
}

.topbar__btn {
  height: 64rpx;
  margin-right: 16rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--text);
  font-size: 26rpx;
  line-height: 64rpx;
}

.topbar__btn--off {
  opacity: 0.4;
}

/* ==================== 模式切换 ==================== */

.modes {
  display: flex;
  align-items: center;
  padding: 4rpx 24rpx 0;
  background: var(--card);
}

.modes__tab {
  margin-right: 24rpx;
  padding-bottom: 8rpx;
  border-bottom: 4rpx solid transparent;
  color: var(--text-sub);
  font-size: 28rpx;
}

.modes__tab--on {
  border-bottom-color: var(--primary);
  color: var(--primary);
  font-weight: 500;
}

/* 笔刷粗细：一整行交给 slider（无级调节），左右各留一个标签与数值 */
.sizes {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx 12rpx;
  background: var(--card);
}

.sizes__label {
  color: var(--text-sub);
  font-size: 24rpx;
}

.sizes__slider {
  flex: 1;
  margin: 0 16rpx;
}

/* 数值用等宽数字，拖动时右侧不会一抖一抖地跳 */
.sizes__value {
  min-width: 64rpx;
  color: var(--text);
  font-size: 24rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* ==================== 画布 ==================== */

.stage {
  position: relative;
  flex: 1;
  overflow: hidden;
  margin: 16rpx 24rpx;
  border-radius: var(--radius);
  /* 默认铺棋盘格：擦掉的地方是透明的，只有背景有纹路才看得出来擦到哪了 */
  background-color: #ffffff;
  background-image:
    linear-gradient(45deg, #e6e1dd 25%, transparent 25%, transparent 75%, #e6e1dd 75%),
    linear-gradient(45deg, #e6e1dd 25%, transparent 25%, transparent 75%, #e6e1dd 75%);
  background-size: 24rpx 24rpx;
  background-position: 0 0, 12rpx 12rpx;
  box-shadow: var(--shadow);
}

/* 白底预览：更接近衣服实物背景，但看不出透明区域 */
.stage--plain {
  background-image: none;
}

.stage__canvas {
  display: block;
  width: 100%;
  height: 100%;
}

/* 底色开关：钉在舞台右上角 */
.stage__bg {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  z-index: 2;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.14);
  color: var(--text-sub);
  font-size: 22rpx;
  line-height: 48rpx;
}

.stage__loading {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.85);
  color: var(--text-sub);
  font-size: 26rpx;
}

/* 裁剪框：用超大 box-shadow 把框外压暗 */
.cropbox {
  position: absolute;
  box-sizing: border-box;
  border: 2rpx solid #ffffff;
  box-shadow: 0 0 0 3000rpx rgba(0, 0, 0, 0.45);
}

.cropbox__corner {
  position: absolute;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid var(--primary);
}

.cropbox__corner--tl {
  top: -2rpx;
  left: -2rpx;
  border-right: none;
  border-bottom: none;
}

.cropbox__corner--tr {
  top: -2rpx;
  right: -2rpx;
  border-bottom: none;
  border-left: none;
}

.cropbox__corner--bl {
  bottom: -2rpx;
  left: -2rpx;
  border-top: none;
  border-right: none;
}

.cropbox__corner--br {
  right: -2rpx;
  bottom: -2rpx;
  border-top: none;
  border-left: none;
}

/* ==================== 提示与底部按钮 ==================== */

.hint {
  padding: 0 32rpx 16rpx;
  color: var(--text-sub);
  font-size: 24rpx;
  text-align: center;
}

.bottom {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  background: var(--card);
}

.bottom__btn {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--text);
  font-size: 30rpx;
  text-align: center;
  line-height: 84rpx;
}

.bottom__btn--primary {
  margin-left: 20rpx;
  background: var(--primary);
  color: #ffffff;
}
