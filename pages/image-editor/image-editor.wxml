<view class="editor">
  <!-- 顶部操作 -->
  <view class="topbar">
    <view class="topbar__btn" bindtap="onCloudCutout" hover-class="btn-hover">云端抠图</view>
    <view
      class="topbar__btn {{canUndo ? '' : 'topbar__btn--off'}}"
      bindtap="onUndo"
      hover-class="btn-hover"
    >撤销</view>
    <view
      class="topbar__btn {{canRedo ? '' : 'topbar__btn--off'}}"
      bindtap="onRedo"
      hover-class="btn-hover"
    >重做</view>
    <view class="topbar__btn" bindtap="onReset" hover-class="btn-hover">重置</view>
  </view>

  <!-- 模式切换 -->
  <view class="modes">
    <view
      class="modes__tab {{mode === 'erase' ? 'modes__tab--on' : ''}}"
      data-mode="erase"
      bindtap="onModeTap"
    >橡皮擦</view>
    <view
      class="modes__tab {{mode === 'brush' ? 'modes__tab--on' : ''}}"
      data-mode="brush"
      bindtap="onModeTap"
    >画笔恢复</view>
    <view
      class="modes__tab {{mode === 'crop' ? 'modes__tab--on' : ''}}"
      data-mode="crop"
      bindtap="onModeTap"
    >裁剪</view>
  </view>

  <!-- 笔刷粗细：无级滑动调节，橡皮擦与画笔恢复共用 -->
  <view class="sizes" wx:if="{{mode !== 'crop'}}">
    <text class="sizes__label">笔刷</text>
    <slider
      class="sizes__slider"
      min="{{brushMin}}"
      max="{{brushMax}}"
      step="1"
      value="{{brushSize}}"
      block-size="24"
      block-color="#ffffff"
      activeColor="#e0745e"
      backgroundColor="#ede7e3"
      bindchanging="onBrushChanging"
      bindchange="onBrushChange"
    />
    <text class="sizes__value">{{brushText}}</text>
  </view>

  <!-- 画布 -->
  <view class="stage {{bgPlain ? 'stage--plain' : ''}}">
    <!-- 画布节点与触摸事件都由 image-canvas 组件管，坐标仍是画布坐标系 -->
    <image-canvas
      id="editor"
      class="stage__canvas"
      interactive="{{true}}"
      bind:touchstart="onTouchStart"
      bind:touchmove="onTouchMove"
      bind:touchend="onTouchEnd"
      bind:touchcancel="onTouchEnd"
    />

    <!-- 白底看不出擦掉了什么，这里给个底色开关 -->
    <view class="stage__bg" catchtap="onToggleBg">{{bgPlain ? '白底' : '棋盘格'}}</view>

    <!-- 裁剪框：用普通视图画，拖动时不需要重绘 canvas -->
    <view wx:if="{{cropStyle}}" class="cropbox" style="{{cropStyle}}">
      <view class="cropbox__corner cropbox__corner--tl"></view>
      <view class="cropbox__corner cropbox__corner--tr"></view>
      <view class="cropbox__corner cropbox__corner--bl"></view>
      <view class="cropbox__corner cropbox__corner--br"></view>
    </view>

    <view wx:if="{{loading}}" class="stage__loading">图片加载中…</view>
  </view>

  <view class="hint">{{hint}}</view>

  <!-- 底部：确定 / 取消 -->
  <view class="bottom">
    <view class="bottom__btn" bindtap="onCancel" hover-class="btn-hover">取消</view>
    <view class="bottom__btn bottom__btn--primary" bindtap="onConfirm" hover-class="btn-hover">确定</view>
  </view>
</view>
