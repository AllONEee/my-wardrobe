/* ==================== 搜索 ==================== */

.search {
  padding-bottom: 20rpx;
}

.search__box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--card);
  box-shadow: var(--shadow);
}

.search__icon {
  position: relative;
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 18rpx;
  border: 3rpx solid var(--text-light);
  border-radius: 50%;
}

.search__icon::after {
  content: '';
  position: absolute;
  right: -9rpx;
  bottom: -3rpx;
  width: 14rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: var(--text-light);
  transform: rotate(45deg);
}

.search__input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  font-size: 28rpx;
}

.search__clear {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: var(--bg);
  color: var(--text-sub);
  font-size: 24rpx;
  line-height: 1;
}

/* ==================== 筛选 ==================== */

.filters {
  padding: 0 8rpx;
}

.filters__row {
  display: flex;
  align-items: center;
}

.filters__row + .filters__row {
  margin-top: 4rpx;
}

.filters__label {
  flex: none;
  width: 76rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

.filters__scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

/* 隐藏横向滚动条 */
.filters__scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.filters__chips {
  display: inline-flex;
  align-items: center;
  padding-right: 30rpx;
}

/* ==================== 统计行 ==================== */

.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 16rpx;
}

.summary__count {
  color: var(--text-sub);
  font-size: 24rpx;
}

.link {
  color: var(--primary);
  font-size: 26rpx;
}

/* ==================== 网格（每行 3 个） ==================== */

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.grid__cell {
  box-sizing: border-box;
  width: 33.3333%;
  padding: 0 8rpx 20rpx;
}
