:host {
  display: block;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx 80rpx;
  text-align: center;
}

.empty__art {
  box-sizing: border-box;
  width: 132rpx;
  height: 148rpx;
  padding: 34rpx 24rpx;
  border: 4rpx solid var(--border);
  border-radius: 20rpx;
  background: var(--card);
}

.empty__art-line {
  height: 8rpx;
  border-radius: 8rpx;
  background: var(--border);
}

.empty__art-line--short {
  width: 60%;
  margin-top: 18rpx;
}

.empty__title {
  margin-top: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.empty__desc {
  max-width: 480rpx;
  margin-top: 12rpx;
  color: var(--text-sub);
  font-size: 25rpx;
  line-height: 1.7;
}

.empty__action {
  margin-top: 40rpx;
  height: 76rpx;
  padding: 0 48rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-size: 28rpx;
  line-height: 76rpx;
}
